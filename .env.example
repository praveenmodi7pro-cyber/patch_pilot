# Application Environment
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-secure-32-byte-hex-string-for-jwt-signing
PORT=8000
HOST=0.0.0.0

# Database & Redis
# For SQLite local dev: sqlite+aiosqlite:///./patchpilot.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/patchpilot
DATABASE_URL=sqlite+aiosqlite:///./patchpilot.db
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: "mock", "gemini", "openai", "anthropic"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# External Integrations - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Limits and Sandbox Controls
MAX_UPLOAD_SIZE_MB=50
ANALYSIS_TIMEOUT_SECONDS=300
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=60
STORAGE_PATH=./storage
SANDBOX_WORKSPACE_PATH=./sandboxes

